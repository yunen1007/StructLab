<Window x:Class="StructLab.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="StructLab｜S2K／F2K 基礎整合檢視器"
        Width="1440" Height="900" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop" Closed="Window_Closed">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="8" />
    </Style>
  </Window.Resources>
  <Grid Background="#FFF5F6F8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="#FF173B5E" Padding="14,10">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <TextBlock VerticalAlignment="Center" Foreground="White" FontSize="20" FontWeight="SemiBold" Text="StructLab" />
          <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FFD9E6F2" Text="原生 C＃ S2K／F2K 檢視與計算" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Click="OpenS2k_Click" Content="匯入 S2K 檔案" />
          <Button Click="ExportTable_Click" Content="匯出目前表格 CSV" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border BorderBrush="#FFD8DEE6" BorderThickness="0,0,1,0" Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <GroupBox Header="模型摘要">
              <StackPanel Margin="8">
                <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" Text="{Binding ProgramVersion}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UnitsLabel}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding CountsLabel}" TextWrapping="Wrap" />
              </StackPanel>
            </GroupBox>
            <GroupBox Header="選取的桿件">
              <TextBlock Margin="8" Text="{Binding SelectedObjectDetails}" TextWrapping="Wrap" />
            </GroupBox>
            <GroupBox Header="S2K 原始資料表">
              <StackPanel Margin="8">
                <ComboBox ItemsSource="{Binding TableNames}" SelectedIndex="0" SelectionChanged="TableSelectionChanged" />
                <TextBox Margin="0,8,0,0" Text="{Binding TableSearch, UpdateSourceTrigger=PropertyChanged}" TextChanged="TableSearch_TextChanged" ToolTip="搜尋目前表格" />
              </StackPanel>
            </GroupBox>
            <GroupBox Header="原生遷移狀態">
              <TextBlock Margin="8" TextWrapping="Wrap" Foreground="#FF475569" Text="此程式不會載入 HTML、JavaScript、WebView2 或 CDN。3D 場景使用原生 WPF 視窗與 DirectX 11 GPU 繪圖。" />
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <TabControl Grid.Column="1" Margin="10">
        <TabItem Header="原生 3D 雛形">
          <Grid Margin="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="8,4,8,8">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Click="FitView_Click" Content="填滿視窗" />
                <Button Click="IsometricView_Click" Content="3D 視角" />
                <Button Click="TopView_Click" Content="俯視" />
                <Button Click="FrontView_Click" Content="前視" />
                <Button Click="RightView_Click" Content="右視" />
              </StackPanel>
              <TextBlock VerticalAlignment="Center" Foreground="#FF475569" Text="可旋轉、平移、縮放；也可直接把 .s2k 拖入視窗。" />
            </DockPanel>
            <Border Grid.Row="1" Margin="8" Background="#FF0F172A" BorderBrush="#FFD8DEE6" BorderThickness="1">
              <hx:Viewport3DX x:Name="ModelViewport"
                             BackgroundColor="#FF0F172A"
                             Camera="{Binding Camera}"
                             EffectsManager="{Binding EffectsManager}"
                             ShowCoordinateSystem="True" ShowViewCube="True"
                             IsViewCubeEdgeClicksEnabled="True">
                <hx:AmbientLight3D Color="#FFFFFFFF" />
                <hx:LineGeometryModel3D Geometry="{Binding AreaGeometry}" Color="#FF64748B"
                                        Thickness="1" IsHitTestVisible="False" />
                <hx:LineGeometryModel3D Geometry="{Binding FrameGeometry}" Color="#FF38BDF8"
                                        Thickness="1.25" HitTestThickness="8"
                                        MouseDown3D="FrameModel_MouseDown3D" />
                <hx:PointGeometryModel3D Geometry="{Binding JointGeometry}" Color="#FFE2E8F0"
                                         Size="2,2" IsHitTestVisible="False" />
                <hx:LineGeometryModel3D Geometry="{Binding SelectionGeometry}" Color="#FFFACC15"
                                        Thickness="4" IsHitTestVisible="False" />
              </hx:Viewport3DX>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="模型總覽">
          <Grid Margin="8">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <GroupBox Header="節點">
              <DataGrid ItemsSource="{Binding Joints}" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" />
            </GroupBox>
            <GroupBox Grid.Row="1" Header="桿件">
              <DataGrid ItemsSource="{Binding Frames}" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" />
            </GroupBox>
          </Grid>
        </TabItem>
        <TabItem Header="原始 S2K 表格">
          <DataGrid Margin="8" ItemsSource="{Binding TableView}" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" />
        </TabItem>
        <TabItem Header="台灣鋼結構斷面分類">
          <DataGrid Margin="8" ItemsSource="{Binding SectionClassifications}" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" />
        </TabItem>
        <TabItem Header="重力載重彙整">
          <DataGrid Margin="8" ItemsSource="{Binding LoadSummaries}" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" />
        </TabItem>
      </TabControl>
    </Grid>

    <Border Grid.Row="2" Background="#FFE9EEF4" Padding="8,5">
      <TextBlock Foreground="#FF334155" Text="{Binding StatusMessage}" />
    </Border>
  </Grid>
</Window>
